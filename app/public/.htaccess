RewriteEngine On

# Non toccare file/cartelle esistenti (assets, uploads, script .php reali)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /sitemap.xml -> sitemap dinamica per Google Search Console
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# /robots.txt -> generato dinamicamente (usa siteUrl() per la riga Sitemap, invece di un dominio fisso)
RewriteRule ^robots\.txt$ robots.php [L]

# API pubblica /api/v1/social-posts/* (token Bearer, vedi app/src/api_helpers.php) — le rotte
# fisse (create/list) devono stare PRIMA di quella generica /{id}, altrimenti quest'ultima le
# intercetterebbe per prima interpretandole come un ID non numerico.
RewriteRule ^api/v1/social-posts/create/?$ api_social_posts_create.php [L,QSA]
RewriteRule ^api/v1/social-posts/list/?$ api_social_posts_list.php [L,QSA]
RewriteRule ^api/v1/social-posts/([0-9]+)/?$ api_social_posts_item.php?id=$1 [L,QSA]

# API pubblica /api/v1/blog-posts/* — stesso token Bearer e stessa autenticazione di
# social-posts (vedi app/src/api_helpers.php), endpoint separati per gestire gli articoli del Blog.
RewriteRule ^api/v1/blog-posts/create/?$ api_blog_posts_create.php [L,QSA]
RewriteRule ^api/v1/blog-posts/list/?$ api_blog_posts_list.php [L,QSA]
RewriteRule ^api/v1/blog-posts/([0-9]+)/?$ api_blog_posts_item.php?id=$1 [L,QSA]

# /nomeartista/che-amo -> vetrina di tutti i moduli "che amo" (Band/Attori/Film/Libri, Viaggi, Brani)
RewriteRule ^([a-zA-Z0-9_-]+)/che-amo/?$ che_amo.php?slug=$1 [L,QSA]

# /nomeartista/blog/anno.mese.giorno.slug-articolo -> singolo articolo (permalink SEO)
RewriteRule ^([a-zA-Z0-9_-]+)/blog/([0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[a-zA-Z0-9-]+)/?$ blog_post.php?slug=$1&post=$2 [L,QSA]

# /nomeartista/blog/categoria/nome-categoria -> elenco articoli filtrato per categoria
RewriteRule ^([a-zA-Z0-9_-]+)/blog/categoria/([a-zA-Z0-9-]+)/?$ blog_category.php?slug=$1&category=$2 [L,QSA]

# /nomeartista/blog -> elenco articoli
RewriteRule ^([a-zA-Z0-9_-]+)/blog/?$ blog_index.php?slug=$1 [L,QSA]

# /nomeartista/brani/ID -> pagina dedicata al singolo brano (condivisibile sui social)
RewriteRule ^([a-zA-Z0-9_-]+)/brani/([0-9]+)/?$ track.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/brani -> pagina brani musicali
RewriteRule ^([a-zA-Z0-9_-]+)/brani/?$ brani.php?slug=$1 [L,QSA]

# /nomeartista/eventi/ID -> pagina dedicata al singolo evento (condivisibile sui social)
RewriteRule ^([a-zA-Z0-9_-]+)/eventi/([0-9]+)/?$ evento.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/feed -> feed RSS/XML (per Metricool e altri strumenti di pianificazione social)
RewriteRule ^([a-zA-Z0-9_-]+)/feed/?$ feed.php?slug=$1 [L,QSA]

# /nomeartista/cinema-feed.xml -> feed prodotti (film in programmazione) per Google Merchant
# Center e Meta Commerce Manager, generato dal JSON già configurato in Dashboard -> Cinema
RewriteRule ^([a-zA-Z0-9_-]+)/cinema-feed\.xml$ cinema_merchant_feed.php?slug=$1 [L,QSA]

# /nomeartista/brani/ID/votazioni -> pagina dedicata al voto del brano
RewriteRule ^([a-zA-Z0-9_-]+)/brani/([0-9]+)/votazioni/?$ track_review.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/brani/ID/testo -> pagina dedicata al testo/ascolto del brano
RewriteRule ^([a-zA-Z0-9_-]+)/brani/([0-9]+)/testo/?$ track_lyrics.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/brani/ID/scheda -> pagina di dettaglio del singolo "Brano che amo" (condivisibile
# sui social) — non può stare su /brani/ID "nudo" perché quella route è già di track.php (tabella
# audio_tracks, funzione diversa e precedente: brani caricati come file, non brani Spotify).
RewriteRule ^([a-zA-Z0-9_-]+)/brani/([0-9]+)/scheda/?$ favorite_track_item.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/timeline/ID -> pagina dedicata al singolo aggiornamento (condivisibile sui social)
RewriteRule ^([a-zA-Z0-9_-]+)/timeline/([0-9]+)/?$ timeline_post.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/timeline -> timeline unificata blog+brani+eventi+aggiornamenti
RewriteRule ^([a-zA-Z0-9_-]+)/timeline/?$ timeline.php?slug=$1 [L,QSA]

# /nomeartista/eventi -> pagina concerti
RewriteRule ^([a-zA-Z0-9_-]+)/eventi/?$ eventi.php?slug=$1 [L,QSA]

# /nomeartista/band-che-amo/ID -> pagina dedicata alla singola band preferita (condivisibile sui social)
RewriteRule ^([a-zA-Z0-9_-]+)/band-che-amo/([0-9]+)/?$ fan_favorite_item.php?slug=$1&kind=band&id=$2 [L,QSA]

# /nomeartista/band-che-amo -> elenco completo band preferite
RewriteRule ^([a-zA-Z0-9_-]+)/band-che-amo/?$ band_che_amo.php?slug=$1 [L,QSA]

