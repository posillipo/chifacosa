# /nomeartista/contatti -> form di contatto
RewriteRule ^([a-zA-Z0-9_-]+)/contatti/?$ contatti.php?slug=$1 [L,QSA]

# /nomeartista/spotify -> pagina discografia Spotify
RewriteRule ^([a-zA-Z0-9_-]+)/spotify/?$ artist_spotify.php?slug=$1 [L,QSA]

# /nomeartista/menu -> pagina menù (ristoranti e simili)
RewriteRule ^([a-zA-Z0-9_-]+)/menu/?$ menu.php?slug=$1 [L,QSA]

# /nomeartista/offerte/ID -> pagina dedicata alla singola offerta (condivisibile sui social)
RewriteRule ^([a-zA-Z0-9_-]+)/offerte/([0-9]+)/?$ offerta.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/offerte -> elenco offerte speciali attive
RewriteRule ^([a-zA-Z0-9_-]+)/offerte/?$ offerte.php?slug=$1 [L,QSA]

# /nomeartista/album/ID -> pagina dedicata al singolo album fotografico (condivisibile sui social)
RewriteRule ^([a-zA-Z0-9_-]+)/album/([0-9]+)/?$ album_item.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/foto -> vetrina foto (post Timeline con foto + album)
RewriteRule ^([a-zA-Z0-9_-]+)/foto/?$ foto.php?slug=$1 [L,QSA]

# /nomeartista/servizi/ID -> pagina dedicata al singolo servizio (condivisibile sui social)
RewriteRule ^([a-zA-Z0-9_-]+)/servizi/([0-9]+)/?$ servizio_item.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/servizi -> elenco servizi pubblicati
RewriteRule ^([a-zA-Z0-9_-]+)/servizi/?$ servizi.php?slug=$1 [L,QSA]

# /nomeartista/video -> pagina video YouTube
RewriteRule ^([a-zA-Z0-9_-]+)/video/?$ video.php?slug=$1 [L,QSA]

# /nomeartista/podcast -> pagina episodi podcast Spotify
RewriteRule ^([a-zA-Z0-9_-]+)/podcast/?$ podcast.php?slug=$1 [L,QSA]

# /nomeartista -> pagina profilo pubblica (regola generica, deve restare per ultima)
RewriteRule ^([a-zA-Z0-9_-]+)/?$ u.php?slug=$1 [L,QSA]
