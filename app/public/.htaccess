RewriteRule ^([a-zA-Z0-9_-]+)/album-che-amo/([0-9]+)/?$ fan_favorite_item.php?slug=$1&kind=album&id=$2 [L,QSA]

# /nomeartista/album-che-amo -> elenco completo album preferiti
RewriteRule ^([a-zA-Z0-9_-]+)/album-che-amo/?$ album_che_amo.php?slug=$1 [L,QSA]

