RewriteRule ^([a-zA-Z0-9_-]+)/attori-che-amo/([0-9]+)/?$ fan_favorite_item.php?slug=$1&kind=actor&id=$2 [L,QSA]

# /nomeartista/attori-che-amo -> elenco completo attori preferiti
