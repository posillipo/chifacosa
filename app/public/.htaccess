RewriteRule ^([a-zA-Z0-9_-]+)/viaggi/([0-9]+)/?$ viaggio_item.php?slug=$1&id=$2 [L,QSA]

# /nomeartista/viaggi -> elenco completo viaggi
RewriteRule ^([a-zA-Z0-9_-]+)/viaggi/?$ viaggi.php?slug=$1 [L,QSA]

# /nomeartista/playlist-che-amo/ID -> pagina dedicata alla singola playlist preferita (condivisibile sui social)
RewriteRule ^([a-zA-Z0-9_-]+)/playlist-che-amo/([0-9]+)/?$ fan_favorite_item.php?slug=$1&kind=playlist&id=$2 [L,QSA]

# /nomeartista/playlist-che-amo -> elenco completo playlist preferite
RewriteRule ^([a-zA-Z0-9_-]+)/playlist-che-amo/?$ playlist_che_amo.php?slug=$1 [L,QSA]

