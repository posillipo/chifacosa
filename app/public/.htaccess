RewriteRule ^([a-zA-Z0-9_-]+)/squadre-che-amo/([0-9]+)/?$ fan_favorite_item.php?slug=$1&kind=team&id=$2 [L,QSA]

# /nomeartista/squadre-che-amo -> elenco completo squadre preferite
