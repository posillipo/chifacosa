RewriteRule ^([a-zA-Z0-9_-]+)/film-che-amo/([0-9]+)/?$ fan_favorite_item.php?slug=$1&kind=movie&id=$2 [L,QSA]

# /nomeartista/film-che-amo -> elenco completo film preferiti
